import { useState, useEffect } from 'react';
import { motion } from 'framer-motion';
import { ArrowRight, CheckCircle, Star, TrendingUp, Users, Zap, MessageSquare, Copy, Share2 } from 'lucide-react';
import { supabase } from './lib/supabase';
import Feedback from './Feedback';

const FORMSPREE_ENDPOINT = import.meta.env.VITE_FORMSPREE_ENDPOINT;

export default function TradeArenaWaitlist() {
  const [email, setEmail] = useState('');
  const [isSubmitted, setIsSubmitted] = useState(false);
  const [isLoading, setIsLoading] = useState(false);
  const [refCode, setRefCode] = useState('');
  const [copied, setCopied] = useState(false);
  const [error, setError] = useState('');
  const [showFeedback, setShowFeedback] = useState(false);
  const [referredBy, setReferredBy] = useState(null);

  // Check for referral code on component mount
  useEffect(() => {
    const urlParams = new URLSearchParams(window.location.search);
    const ref = urlParams.get('ref');
    if (ref) {
      setReferredBy(ref);
      localStorage.setItem('ta_ref', ref);
    } else {
      const storedRef = localStorage.getItem('ta_ref');
      if (storedRef) {
        setReferredBy(storedRef);
      }
    }
  }, []);

  const validateEmail = (email) => {
    const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return re.test(email);
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError('');
    setCopied(false);

    if (!validateEmail(email)) {
      setError('Please enter a valid email.');
      return;
    }

    setIsLoading(true);
    try {
      // Check if Supabase is properly configured
      const isSupabaseConfigured = import.meta.env.VITE_SUPABASE_URL && 
        import.meta.env.VITE_SUPABASE_URL !== 'https://placeholder.supabase.co';

      let myRef = '';
      
      if (isSupabaseConfigured) {
        // 1) Insert into Supabase (source of truth)
        const { data, error } = await supabase
          .from('waitlist')
          .insert({ email, referred_by: referredBy })
          .select('ref_code')
          .single();

        if (error) throw error;
        myRef = data.ref_code;
      } else {
        // Fallback: generate a simple ref code
        myRef = Math.random().toString(36).substring(2, 10).toUpperCase();
      }

      setRefCode(myRef);
      setIsSubmitted(true);

      // 2) Notify Formspree so you get an email ping
      try {
        await fetch(FORMSPREE_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            email,
            referredBy,
            source: 'waitlist',
            ref_code_assigned: myRef,
          }),
        });
      } catch {
        // non-fatal: even if Formspree fails, we already saved in Supabase
      }

      // 3) Build & copy share link
      const link = `${window.location.origin}?ref=${myRef}`;
      try {
        await navigator.clipboard.writeText(link);
        setCopied(true);
      } catch {}
    } catch (err) {
      setError(err.message || 'Something went wrong.');
    } finally {
      setIsLoading(false);
    }
  };

  const features = [
    {
      icon: <TrendingUp className="w-6 h-6" />,
      title: "Advanced Analytics",
      description: "Real-time market insights and performance tracking"
    },
    {
      icon: <Zap className="w-6 h-6" />,
      title: "Lightning Fast",
      description: "Ultra-low latency trading execution"
    },
    {
      icon: <Users className="w-6 h-6" />,
      title: "Community Driven",
      description: "Connect with traders and share strategies"
    }
  ];

  return (
    <div 
      className="min-h-screen bg-gradient-to-br from-slate-900 via-blue-900 to-slate-900 text-white"
      style={{
        minHeight: '100vh',
        background: 'linear-gradient(135deg, #0f172a 0%, #1e3a8a 50%, #0f172a 100%)',
        position: 'relative'
      }}
    >
      {/* Background Pattern */}
      <div 
        className="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%239C92AC%22%20fill-opacity%3D%220.05%22%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%2230%22%20r%3D%222%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-20"
        style={{
          position: 'absolute',
          top: 0,
          left: 0,
          right: 0,
          bottom: 0,
          backgroundImage: `url("data:image/svg+xml,%3Csvg%20width%3D%2260%22%20height%3D%2260%22%20viewBox%3D%220%200%2060%2060%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Cg%20fill%3D%22none%22%20fill-rule%3D%22evenodd%22%3E%3Cg%20fill%3D%22%239C92AC%22%20fill-opacity%3D%220.05%22%3E%3Ccircle%20cx%3D%2230%22%20cy%3D%2230%22%20r%3D%222%22/%3E%3C/g%3E%3C/g%3E%3C/svg%3E")`,
          opacity: 0.2
        }}
      ></div>
      
      <div 
        className="relative z-10 container mx-auto px-4 py-16"
        style={{
          position: 'relative',
          zIndex: 10,
          maxWidth: '1200px',
          margin: '0 auto',
          padding: '4rem 1rem'
        }}
      >
        {/* Header */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.8 }}
          className="text-center mb-16 rounded-2xl p-8 bg-white/10 border border-white/20 shadow-xl shadow-black/30"
          style={{
            textAlign: 'center',
            marginBottom: '4rem'
          }}
        >
          <div 
            className="inline-flex items-center gap-2 bg-blue-500/10 border border-blue-500/20 rounded-full px-4 py-2 mb-6"
            style={{
              display: 'inline-flex',
              alignItems: 'center',
              gap: '0.5rem',
              backgroundColor: 'rgba(59, 130, 246, 0.1)',
              border: '1px solid rgba(59, 130, 246, 0.2)',
              borderRadius: '9999px',
              padding: '0.5rem 1rem',
              marginBottom: '1.5rem'
            }}
          >
            <Star className="w-4 h-4 text-sky-400" style={{ width: '1rem', height: '1rem', color: '#38bdf8' }} />
            <span className="text-sm text-sky-300" style={{ fontSize: '0.875rem', color: '#93c5fd' }}>Coming Soon</span>
          </div>
          
          <h1 
            className="text-5xl md:text-7xl font-bold text-white mb-6"
            style={{
              fontSize: 'clamp(3rem, 8vw, 4.5rem)',
              fontWeight: 'bold',
              color: 'white',
              marginBottom: '1.5rem',
              lineHeight: '1.1'
            }}
          >
            Trade <span 
              className="bg-gradient-to-r from-sky-400 to-cyan-400 bg-clip-text text-transparent"
              style={{
                background: 'linear-gradient(to right, #38bdf8, #22d3ee)',
                WebkitBackgroundClip: 'text',
                WebkitTextFillColor: 'transparent',
                backgroundClip: 'text'
              }}
            >Arena</span>
          </h1>
          
          <p 
            className="text-xl text-gray-300 max-w-2xl mx-auto mb-8"
            style={{
              fontSize: '1.25rem',
              color: '#d1d5db',
              maxWidth: '42rem',
              margin: '0 auto 2rem',
              lineHeight: '1.6'
            }}
          >
            The next generation trading platform for serious traders. 
            Join the waitlist and be among the first to experience the future of trading.
          </p>
        </motion.div>

        {/* Features Grid */}
        <motion.div
          initial={{ opacity: 0, y: 40 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.8, delay: 0.2 }}
          className="grid md:grid-cols-3 gap-8 mb-16 text-white"
        >
          {features.map((feature, index) => (
            <motion.div
              key={index}
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.6, delay: 0.3 + index * 0.1 }}
              className="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-all duration-300"
            >
              <div className="text-sky-400 mb-4">
                {feature.icon}
              </div>
              <h3 className="text-xl font-semibold text-white mb-2">
                {feature.title}
              </h3>
              <p className="text-white">
                {feature.description}
              </p>
            </motion.div>
          ))}
        </motion.div>

        {/* Marketing Sections */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6 }}
          className="grid gap-8 mb-16 text-white leading-relaxed"
        >
          {/* Title block */}
          <section className="rounded-2xl p-8 bg-white/10 border border-white/20 shadow-lg shadow-black/20">
            <div className="flex items-center gap-3 mb-2">
              <span className="text-2xl">🏆</span>
              <h2 className="text-2xl md:text-3xl font-bold text-white tracking-tight">TRADE ARENA</h2>
            </div>
            <p className="text-sky-300 font-semibold">Compete. Trade. Win.</p>
            <p className="mt-3">The world’s first head-to-head trading platform.</p>
            <p className="mt-1">Battle other traders in real-time simulated markets — prove your skill, climb leaderboards, and earn rewards.</p>
          </section>

          {/* What is Trade Arena - Grid Cards */}
          <div>
            <h3 className="text-2xl font-bold mb-6 text-center">⚔️ What Is Trade Arena?</h3>
            <p className="text-center mb-8 text-sky-200 max-w-3xl mx-auto">
              Head-to-head trading battles on live market data. Test real skill, climb leaderboards, earn rewards.
            </p>
            <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
              <div className="rounded-xl p-6 bg-white/10 border border-white/20 shadow-md">
                <div className="text-3xl mb-3">🎮</div>
                <h4 className="font-semibold mb-2">1v1 Battles</h4>
                <p className="text-sm text-sky-100">Head-to-head on live data. Highest P&L wins.</p>
              </div>
              <div className="rounded-xl p-6 bg-white/10 border border-white/20 shadow-md">
                <div className="text-3xl mb-3">🏅</div>
                <h4 className="font-semibold mb-2">Tournaments</h4>
                <p className="text-sm text-sky-100">Bracket events, bigger pools, reputation points.</p>
              </div>
              <div className="rounded-xl p-6 bg-white/10 border border-white/20 shadow-md">
                <div className="text-3xl mb-3">📊</div>
                <h4 className="font-semibold mb-2">Practice Mode</h4>
                <p className="text-sm text-sky-100">$15/month unlimited simulated trading.</p>
              </div>
              <div className="rounded-xl p-6 bg-white/10 border border-white/20 shadow-md">
                <div className="text-3xl mb-3">🪙</div>
                <h4 className="font-semibold mb-2">Arena Coins</h4>
                <p className="text-sm text-sky-100">In-platform currency for entries and prizes.</p>
              </div>
              <div className="rounded-xl p-6 bg-white/10 border border-white/20 shadow-md">
                <div className="text-3xl mb-3">👑</div>
                <h4 className="font-semibold mb-2">Leaderboards</h4>
                <p className="text-sm text-sky-100">Weekly wins, streaks, and free entries.</p>
              </div>
              <div className="rounded-xl p-6 bg-white/10 border border-white/20 shadow-md">
                <div className="text-3xl mb-3">💰</div>
                <h4 className="font-semibold mb-2">Small Rake</h4>
                <p className="text-sm text-sky-100">2-5% service fee like poker or esports.</p>
              </div>
            </div>
          </div>

          {/* How it works */}
          <div className="rounded-2xl p-8 bg-gradient-to-br from-sky-500/10 to-cyan-500/10 border border-sky-400/30 shadow-lg">
            <h3 className="text-2xl font-bold mb-6 text-center">🚀 How It Works</h3>
            <div className="grid md:grid-cols-3 gap-6">
              <div className="text-center">
                <div className="text-4xl mb-3">1️⃣</div>
                <h4 className="font-semibold mb-2">Join Waitlist</h4>
                <p className="text-sm text-sky-100">Sign up below. One early-access email when ready.</p>
              </div>
              <div className="text-center">
                <div className="text-4xl mb-3">2️⃣</div>
                <h4 className="font-semibold mb-2">Share Your Link</h4>
                <p className="text-sm text-sky-100">Get a referral code. Move up the queue faster.</p>
              </div>
              <div className="text-center">
                <div className="text-4xl mb-3">3️⃣</div>
                <h4 className="font-semibold mb-2">Early Access</h4>
                <p className="text-sm text-sky-100">Demo tournaments, Discord, badges & coins.</p>
              </div>
            </div>
          </div>

          {/* Example Match Structure */}
          <section className="rounded-2xl p-8 bg-white/10 border border-white/20 shadow-lg shadow-black/20">
            <h3 className="text-white text-xl font-semibold mb-3">💸 Example Match Structure</h3>
            <ul className="list-disc pl-6 space-y-1">
              <li>Entry: 10 Arena Coins + 0.5 Coin fee</li>
              <li>Prize Pool: 20 Coins (winner takes all)</li>
              <li>Service Fee: 5% to Trade Arena</li>
            </ul>
            <p className="mt-3">Players can earn fractional coins (like 0.5) through daily quests and streaks. All matches use simulated balances (no live brokerage link needed).</p>
            <p className="mt-1">Live data comes from CME-licensed feeds, displayed with per-viewer data costs we cover through fees and subscriptions.</p>
          </section>

          {/* Skill-based */}
          <section className="rounded-2xl p-8 bg-white/10 border border-white/20 shadow-lg shadow-black/20">
            <h3 className="text-white text-xl font-semibold mb-3">🧠 Why It’s Skill-Based</h3>
            <p className="mb-2">Trading outcomes depend on:</p>
            <ul className="list-disc pl-6 space-y-1">
              <li>Strategy, risk management, and discipline</li>
              <li>Reaction time to changing markets</li>
              <li>Proper sizing and execution</li>
              <li>Psychological composure</li>
            </ul>
            <p className="mt-3">It’s not gambling — matches are deterministic based on your trades, just like chess or poker with perfect logs. We’re building a transparent and competitive environment for traders to prove skill over luck.</p>
          </section>

          {/* Rewards */}
          <section className="rounded-2xl p-8 bg-white/10 border border-white/20 shadow-lg shadow-black/20">
            <h3 className="text-white text-xl font-semibold mb-3">🧩 Rewards & Progression</h3>
            <ul className="list-disc pl-6 space-y-1">
              <li>🏆 Top performers each week earn free entries and Arena Coins.</li>
              <li>🎯 Referral bonuses: bring friends, move up the waitlist, and unlock early tournaments.</li>
              <li>💎 Seasonal rankings, badges, and reputation points for consistent winners.</li>
              <li>🎁 Special drops for early adopters and content creators.</li>
            </ul>
          </section>

          {/* Mission */}
          <section className="rounded-2xl p-8 bg-white/10 border border-white/20 shadow-lg shadow-black/20">
            <h3 className="text-white text-xl font-semibold mb-3">🧠 Our Mission</h3>
            <p>To make trading fun, fair, and competitive — like esports, but for markets. No fake gurus. No hidden leverage. Just raw skill, transparent competition, and community.</p>
          </section>

          {/* Sustain */}
          <section className="rounded-2xl p-8 bg-white/10 border border-white/20 shadow-lg shadow-black/20">
            <h3 className="text-white text-xl font-semibold mb-3">🪙 How We Sustain It</h3>
            <ul className="list-disc pl-6 space-y-1">
              <li>$15/month practice memberships help offset data feed costs.</li>
              <li>1v1 matches and tournaments include small rake fees (2–5%).</li>
              <li>CME data licensing ensures all price data is legal and accurate.</li>
              <li>Stripe handles payments securely (3.3% fee on deposits).</li>
            </ul>
          </section>

          {/* Feedback Welcome */}
          <section className="rounded-2xl p-8 bg-white/10 border border-white/20 shadow-lg shadow-black/20">
            <h3 className="text-white text-xl font-semibold mb-3">💬 Feedback Welcome</h3>
            <p>Trade Arena is still in pre-launch. We’re inviting early testers to: try ranked and practice modes, suggest new features, report bugs and UX issues.</p>
            <p className="mt-2">Use the form below to tell us what you want to see, or ideas for features, rewards, and tournaments.</p>
          </section>

          {/* Share & Earn */}
          <section className="rounded-2xl p-8 bg-white/10 border border-white/20 shadow-lg shadow-black/20">
            <h3 className="text-white text-xl font-semibold mb-3">🎁 Share & Earn</h3>
            <p>After signing up, you’ll get a custom referral link. Every trader who joins using your link earns you bonus Arena Coins and queue priority. Top referrers will be featured on the public leaderboard at launch.</p>
          </section>

          {/* Socials */}
          <section className="rounded-2xl p-8 bg-white/10 border border-white/20 shadow-lg shadow-black/20">
            <h3 className="text-white text-xl font-semibold mb-3">📣 Socials & Updates</h3>
            <ul className="list-disc pl-6 space-y-1">
              <li>Instagram: <a className="text-sky-300 hover:text-sky-200" href="#" target="_blank" rel="noreferrer">@tradearena</a></li>
              <li>X (Twitter): <a className="text-sky-300 hover:text-sky-200" href="#" target="_blank" rel="noreferrer">@TradeArenaApp</a></li>
              <li>Discord: <a className="text-sky-300 hover:text-sky-200" href="#" target="_blank" rel="noreferrer">Join the early testers</a></li>
            </ul>
          </section>

          {/* Legal */}
          <section className="rounded-2xl p-8 bg-white/10 border border-white/20 shadow-lg shadow-black/20">
            <h3 className="text-white text-xl font-semibold mb-3">⚙️ Legal & Transparency</h3>
            <ul className="list-disc pl-6 space-y-1">
              <li>Trade Arena uses simulated trading only — no live brokerage execution.</li>
              <li>All competitions are skill-based and transparent.</li>
              <li>Licensed CME data feeds ensure accuracy.</li>
              <li>Users must be 18+ to participate.</li>
              <li>Certain regions may have restrictions on real-money contests.</li>
            </ul>
          </section>
        </motion.div>

        {/* Waitlist Form */}
        <motion.div
          id="join"
          initial={{ opacity: 0, y: 40 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.8, delay: 0.4 }}
          className="max-w-md mx-auto"
          style={{
            maxWidth: '28rem',
            margin: '0 auto'
          }}
        >
          {!isSubmitted ? (
            <div 
              className="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8"
              style={{
                backgroundColor: 'rgba(255, 255, 255, 0.05)',
                backdropFilter: 'blur(8px)',
                border: '1px solid rgba(255, 255, 255, 0.1)',
                borderRadius: '1rem',
                padding: '2rem'
              }}
            >
              <h2 
                className="text-2xl font-bold text-white mb-4 text-center"
                style={{
                  fontSize: '1.5rem',
                  fontWeight: 'bold',
                  color: 'white',
                  marginBottom: '1rem',
                  textAlign: 'center'
                }}
              >
                Join the Waitlist
              </h2>
              <p 
                className="text-gray-300 text-center mb-6"
                style={{
                  color: '#d1d5db',
                  textAlign: 'center',
                  marginBottom: '1.5rem'
                }}
              >
                Get early access and exclusive updates
              </p>
              
              <form onSubmit={handleSubmit} className="space-y-4" style={{ display: 'flex', flexDirection: 'column', gap: '1rem' }}>
                <div>
                  <input
                    type="email"
                    value={email}
                    onChange={(e) => setEmail(e.target.value)}
                    placeholder="Enter your email address"
                    required
                    className="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-transparent transition-all duration-300"
                    style={{
                      width: '100%',
                      padding: '0.75rem 1rem',
                      backgroundColor: 'rgba(255, 255, 255, 0.1)',
                      border: '1px solid rgba(255, 255, 255, 0.2)',
                      borderRadius: '0.5rem',
                      color: 'white',
                      fontSize: '1rem',
                      outline: 'none',
                      transition: 'all 0.3s ease'
                    }}
                    onFocus={(e) => {
                      e.target.style.borderColor = '#3b82f6';
                      e.target.style.boxShadow = '0 0 0 2px rgba(59, 130, 246, 0.25)';
                    }}
                    onBlur={(e) => {
                      e.target.style.borderColor = 'rgba(255, 255, 255, 0.2)';
                      e.target.style.boxShadow = 'none';
                    }}
                  />
                  {error && (
                    <p className="text-red-400 text-sm mt-2" style={{ color: '#f87171', fontSize: '0.875rem', marginTop: '0.5rem' }}>{error}</p>
                  )}
                </div>
                
                <button
                  type="submit"
                  disabled={isLoading}
                  className="w-full bg-gradient-to-r from-blue-500 to-cyan-500 hover:from-blue-600 hover:to-cyan-600 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold py-3 px-6 rounded-lg transition-all duration-300 flex items-center justify-center gap-2"
                  style={{
                    width: '100%',
                    background: 'linear-gradient(to right, #3b82f6, #06b6d4)',
                    color: 'white',
                    fontWeight: '600',
                    padding: '0.75rem 1.5rem',
                    borderRadius: '0.5rem',
                    border: 'none',
                    cursor: isLoading ? 'not-allowed' : 'pointer',
                    opacity: isLoading ? 0.5 : 1,
                    display: 'flex',
                    alignItems: 'center',
                    justifyContent: 'center',
                    gap: '0.5rem',
                    transition: 'all 0.3s ease',
                    fontSize: '1rem'
                  }}
                  onMouseEnter={(e) => {
                    if (!isLoading) {
                      e.target.style.background = 'linear-gradient(to right, #2563eb, #0891b2)';
                    }
                  }}
                  onMouseLeave={(e) => {
                    if (!isLoading) {
                      e.target.style.background = 'linear-gradient(to right, #3b82f6, #06b6d4)';
                    }
                  }}
                >
                  {isLoading ? (
                    <div 
                      className="w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin" 
                      style={{
                        width: '1.25rem',
                        height: '1.25rem',
                        border: '2px solid rgba(255, 255, 255, 0.3)',
                        borderTop: '2px solid white',
                        borderRadius: '50%',
                        animation: 'spin 1s linear infinite'
                      }}
                    />
                  ) : (
                    <>
                      Join Waitlist
                      <ArrowRight className="w-4 h-4" style={{ width: '1rem', height: '1rem' }} />
                    </>
                  )}
                </button>
              </form>
            </div>
          ) : (
            <motion.div
              initial={{ opacity: 0, scale: 0.8 }}
              animate={{ opacity: 1, scale: 1 }}
              transition={{ duration: 0.5 }}
              className="bg-white/5 backdrop-blur-sm border border-white/10 rounded-2xl p-8 text-center"
            >
              <CheckCircle className="w-16 h-16 text-green-400 mx-auto mb-4" />
              <h2 className="text-2xl font-bold text-white mb-4">
                You're on the list!
              </h2>
              <p className="text-gray-300 mb-6">
                Thank you for joining our waitlist. We'll notify you as soon as Trade Arena is ready.
              </p>
              
              {refCode && (
                <div className="bg-white/10 rounded-lg p-4 mb-6">
                  <p className="text-sm text-gray-300 mb-3">Your referral code:</p>
                  <div className="flex items-center gap-2 justify-center">
                    <code className="bg-black/20 px-3 py-1 rounded text-sky-300 font-mono">
                      {refCode}
                    </code>
                    <button
                      onClick={() => {
                        const link = `${window.location.origin}?ref=${refCode}`;
                        navigator.clipboard.writeText(link);
                        setCopied(true);
                        setTimeout(() => setCopied(false), 2000);
                      }}
                      className="text-sky-400 hover:text-sky-300 transition-colors"
                    >
                      {copied ? <CheckCircle className="w-4 h-4" /> : <Copy className="w-4 h-4" />}
                    </button>
                  </div>
                  <p className="text-xs text-gray-400 mt-2">
                    Share your link to earn referral bonuses!
                  </p>
                </div>
              )}
              
              <div className="flex gap-3 justify-center">
                <button
                  onClick={() => setIsSubmitted(false)}
                  className="text-sky-400 hover:text-sky-300 transition-colors duration-300"
                >
                  Add another email
                </button>
                <span className="text-gray-500">•</span>
                <button
                  onClick={() => setShowFeedback(true)}
                  className="text-sky-400 hover:text-sky-300 transition-colors duration-300 flex items-center gap-1"
                >
                  <MessageSquare className="w-4 h-4" />
                  Feedback
                </button>
              </div>
            </motion.div>
          )}
        </motion.div>

        {/* Footer */}
        <motion.div
          initial={{ opacity: 0 }}
          animate={{ opacity: 1 }}
          transition={{ duration: 0.8, delay: 0.6 }}
          className="text-center mt-16"
        >
          <div className="inline-block rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-gray-300">
            <p className="text-sm">© 2025 Trade Arena. All rights reserved.</p>
            <p className="text-sm text-gray-400">Built by traders, for traders.</p>
          </div>
        </motion.div>

        {/* Feedback Button */}
        <motion.button
          initial={{ opacity: 0, scale: 0 }}
          animate={{ opacity: 1, scale: 1 }}
          transition={{ duration: 0.5, delay: 1 }}
          onClick={() => setShowFeedback(true)}
          className="fixed bottom-6 right-6 bg-gradient-to-r from-blue-500 to-cyan-500 hover:from-blue-600 hover:to-cyan-600 text-white p-3 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 z-40"
        >
          <MessageSquare className="w-5 h-5" />
        </motion.button>
      </div>

      {/* Feedback Modal */}
      <Feedback isOpen={showFeedback} onClose={() => setShowFeedback(false)} />
    </div>
  );
}
